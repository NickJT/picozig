.{
    .name = .picozig_workspace,
    .version = "0.0.0",
    .fingerprint = 0xaf56ae20a645ac67,
    .minimum_zig_version = "0.17.0",
    // None, deliberately: `build.zig` shells out to each package's own build,
    // because Zig shares modules and artifacts across packages but not the
    // named steps this file aggregates.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
